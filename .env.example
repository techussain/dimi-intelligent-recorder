# ──────────────────────────────────────────────────────────────────────────────
# Dimi Intelligent Recorder — environment variables (reference)
#
# Nothing reads this file automatically. These are the variables the build
# tools look for in the environment; set them in your shell before
# `npm run build:electron` if you want a signed local build. Unsigned builds
# need none of them.
#
# Never commit real values (certificates, passwords) anywhere in the repo.
# ──────────────────────────────────────────────────────────────────────────────

# ── Code signing (electron-builder) ──────────────────────────────────────────
# Path or HTTPS URL to a .p12 / .pfx certificate, and its password. On macOS
# electron-builder can also find a "Developer ID Application" identity in your
# keychain without these. In CI the release workflow maps the repository
# secrets WIN_CSC_LINK / MAC_CSC_LINK (and their passwords) onto these names.
CSC_LINK=
CSC_KEY_PASSWORD=

# ── macOS notarization (optional, with a signing identity) ───────────────────
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Set to "false" to stop electron-builder from searching the macOS keychain
# for a signing identity (builds an unsigned app).
# CSC_IDENTITY_AUTO_DISCOVERY=false

# ── Development (set automatically by `npm run dev:electron`) ────────────────
# VITE_DEV_SERVER_URL=http://localhost:5173
