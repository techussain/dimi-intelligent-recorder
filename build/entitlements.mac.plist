<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 / WebAssembly JIT (ONNX Runtime, mediabunny) under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- WebAssembly memory for ONNX Runtime (on-device transcription). -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Unsigned / ad-hoc signed builds: Electron's frameworks carry no team ID,
         so library validation would refuse to load them. Revisit (and test on a
         Mac) before dropping it for Developer ID-signed releases. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Webcam and microphone recording (usage strings are in Info.plist). -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
